{"factors":[{"id":"ndvi","name":"NDVI (vegetation vigour)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.2,"hi":0.95,"derived":true,"note":"Normalised difference of NIR and red. The workhorse greenness index."},{"id":"evi","name":"EVI (enhanced vegetation)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.1,"hi":0.9,"derived":true,"note":"Less prone to saturation than NDVI over dense canopy."},{"id":"savi","name":"SAVI (soil-adjusted)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.1,"hi":0.85,"derived":true,"note":"Corrects for soil brightness on sparse cover."},{"id":"msavi","name":"MSAVI (modified soil-adjusted)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.1,"hi":0.9,"derived":true,"note":"Self-adjusting soil correction; good on bare ground."},{"id":"gndvi","name":"GNDVI (green NDVI)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.1,"hi":0.85,"derived":true,"note":"Green-band variant, more sensitive to chlorophyll."},{"id":"ndmi","name":"NDMI (moisture)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.5,"hi":0.6,"derived":true,"note":"Canopy water content from NIR and SWIR."},{"id":"nbr","name":"NBR (burn ratio)","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":-0.6,"hi":0.9,"derived":true,"note":"Fire severity and post-burn recovery."},{"id":"chlorophyll_index","name":"Chlorophyll index","base":"sentinel2_sr","group":"Vegetation","unit":"index","kind":"continuous","cadence":"monthly","lo":0.0,"hi":8.0,"derived":true,"note":"Red-edge chlorophyll proxy; early stress signal."},{"id":"leaf_area_index","name":"Leaf area index","base":"sentinel2_sr","group":"Vegetati