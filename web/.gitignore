# Generated by scripts/build-hero-field.mjs from public/basemap/england.json
public/hero/

# Generated by scripts/build-assets.mjs — which asset files exist on disk.
src/site/assets.generated.ts

# Supplied imagery. Photographs and video are large binaries that do not belong
# in git history; they are dropped in per environment or served from wherever
# they are hosted. Track them with git-lfs if you want them versioned — but
# decide that deliberately rather than by committing a 40 MB mp4 once.
public/assets/**
!public/assets/**/README.md
