# Vercel builds the React app in web/ and publishes web/dist, and runs the
# credential-free API as one Python serverless function (api/index.py).
#
# The project's Python modules are NOT excluded any more: the function imports
# them, and vercel.json's functions.includeFiles glob bundles them. Excluding
# them was correct when the only backend was Cloud Run; it would now produce a
# function that cannot import its own catalogue.

# The Earth Engine backend belongs on Cloud Run, not in a serverless function —
# earthengine-api and its Google client stack blow past the bundle limit.
app.py
ee_series.py
Dockerfile
.dockerignore
requirements.txt
requirements-dev.txt
pytest.ini

bench/
ingest/
scripts/
tests/
docs/
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# The prototype is kept in the repo for reference but is not deployed.
site-scanner.html

# demo/ is NOT excluded: vercel.json's buildCommand copies
# demo/site-scanner-demo.html into the build so it is served at /demo.

service-account-key.json
*.key.json
.env
.env.*
